    "ktx2-encoder": "^0.6.0",
    "node-web-audio-api": "^2.2.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.18"
